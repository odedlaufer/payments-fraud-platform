# Copy to .env and adjust. Never commit .env.

# Profiles docker compose runs (also used without make)
COMPOSE_PROFILES=core,lake,stream

# Postgres (OLTP source)
POSTGRES_USER=payments
POSTGRES_PASSWORD=change-me
POSTGRES_DB=payments
POSTGRES_PORT=5432

# S3-compatible object store (SeaweedFS) for Iceberg
S3_ACCESS_KEY=lakeadmin
S3_SECRET_KEY=change-me-lake
S3_API_PORT=8333
LAKE_BUCKET=lake

# Redpanda
REDPANDA_KAFKA_PORT=19092
REDPANDA_SCHEMA_REGISTRY_PORT=18081
REDPANDA_CONSOLE_PORT=8080

# Kafka Connect (Debezium)
CONNECT_PORT=8083
# Password for the least-privilege `debezium` replication role.
DEBEZIUM_DB_PASSWORD=change-me-debezium

# Iceberg catalog (Lakekeeper) and its own Postgres.
# Use URL-safe passwords: they are embedded in a postgresql:// URL.
CATALOG_DB_USER=lakekeeper
CATALOG_DB_PASSWORD=change-me-catalog
CATALOG_DB_NAME=lakekeeper
# Encrypts storage credentials at rest. Changing it after the warehouse exists
# makes the stored credentials unreadable: run `make nuke` first.
LAKEKEEPER_ENCRYPTION_KEY=change-me-to-a-long-random-string
LAKEKEEPER_PORT=8181
WAREHOUSE_NAME=lakehouse

# Trino
TRINO_PORT=8088

# Flink
FLINK_UI_PORT=8081
# Checkpoint = bronze Iceberg commit interval. 60s is the PRD value; 10s locally
# makes verification faster (bronze catches up in seconds).
FLINK_CHECKPOINT_INTERVAL=60s
