# Copy to .env and adjust. Never commit .env.

# Postgres (OLTP source)
POSTGRES_USER=payments
POSTGRES_PASSWORD=change-me
POSTGRES_DB=payments
POSTGRES_PORT=5432

# S3-compatible object store (SeaweedFS) for Iceberg
S3_ACCESS_KEY=lakeadmin
S3_SECRET_KEY=change-me-lake
S3_API_PORT=8333
LAKE_BUCKET=lake

# Redpanda
REDPANDA_KAFKA_PORT=19092
REDPANDA_SCHEMA_REGISTRY_PORT=18081
REDPANDA_CONSOLE_PORT=8080

# Iceberg REST catalog
ICEBERG_REST_PORT=8181

# Trino
TRINO_PORT=8088
