{
  "uid": "platform-slos",
  "title": "Platform SLOs",
  "tags": [
    "slo",
    "payments-fraud-platform"
  ],
  "description": "PRD section 2: the five measured SLOs, live.",
  "timezone": "utc",
  "refresh": "30s",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
