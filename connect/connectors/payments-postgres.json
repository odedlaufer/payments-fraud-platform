{
  "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
  "tasks.max": "1",

  "database.hostname": "postgres",
  "database.port": "5432",
  "database.user": "debezium",
  "database.password": "${env:DEBEZIUM_DB_PASSWORD}",
  "database.dbname": "${env:POSTGRES_DB}",

  "topic.prefix": "pg",
  "plugin.name": "pgoutput",
  "slot.name": "payments_cdc_slot",
  "publication.name": "payments_cdc",
  "publication.autocreate.mode": "disabled",
  "table.include.list": "public.customers,public.cards,public.merchants,public.sessions,public.transactions,public.chargebacks,public.cdc_heartbeat",
  "snapshot.mode": "initial",
  "tombstones.on.delete": "true",
  "decimal.handling.mode": "precise",

  "heartbeat.interval.ms": "10000",
  "heartbeat.action.query": "UPDATE public.cdc_heartbeat SET beat_at = now() WHERE id = 1",

  "key.converter": "io.confluent.connect.avro.AvroConverter",
  "key.converter.schema.registry.url": "http://redpanda:8081",
  "value.converter": "io.confluent.connect.avro.AvroConverter",
  "value.converter.schema.registry.url": "http://redpanda:8081",
  "schema.name.adjustment.mode": "avro",
  "field.name.adjustment.mode": "avro",

  "topic.creation.default.replication.factor": "1",
  "topic.creation.default.partitions": "1",
  "topic.creation.default.cleanup.policy": "delete"
}
